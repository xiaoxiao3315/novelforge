NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# 仅服务端使用：用于安全退款等内部补偿操作，不能暴露给浏览器。
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
INTERNAL_GUEST_EMAIL=novelforge.guest@example.com
INTERNAL_GUEST_PASSWORD=change-this-in-production
# Mock 支付开关：仅本地/测试环境设为 true；生产环境始终禁用。
ENABLE_MOCK_PAYMENTS=false
# 互动模式下章节生成后自动附带命运分歧（额外一次 AI 调用），默认关闭。
ENABLE_AUTO_CHAPTER_DECISION=false
